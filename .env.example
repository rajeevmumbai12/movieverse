# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/movieverse

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Environment
NODE_ENV=development

# Redis Configuration (Optional - for queue system)
# Set ENABLE_QUEUE=false for Vercel deployment
ENABLE_QUEUE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Frontend API URL (optional - auto-detects in production)
# For local testing with vercel dev, use:
REACT_APP_API_URL=http://localhost:3000/api
# For production, this is handled automatically

# For serverless deployment, use the following settings:
# MONGODB_URI=mongodb://localhost:27017/movieverse // change to your production DB URI
# JWT_SECRET=your_production_secret
# JWT_EXPIRE=7d
# ENABLE_QUEUE=false
# NODE_ENV=production
