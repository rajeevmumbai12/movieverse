PORT=5000
MONGODB_URI=mongodb://localhost:27017/movieverse
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development

# Redis Configuration (Optional - for queue system)
# Set ENABLE_QUEUE=true only if you have Redis installed
ENABLE_QUEUE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
